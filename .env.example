# MARKETECTURE Environment Configuration
# Copy this to .env.local and fill in values

# WordPress API (public, no key needed for wordpress.com free tier)
NEXT_PUBLIC_WP_API_URL=https://public-api.wordpress.com/wp/v2/sites/marketecture5.wordpress.com
WP_API_URL=https://public-api.wordpress.com/wp/v2/sites/marketecture5.wordpress.com

# AI Integration (optional - demo mode works without these)
# Supports OpenAI, Google Gemini, or other OpenAI-compatible APIs
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=

# Site URL for SEO
NEXT_PUBLIC_SITE_URL=https://marketecture.vercel.app
